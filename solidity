pragma solidity ^0.8.20;

contract SmartMusic {
    struct Song {
        uint id;
        string title;
        address owner;
        uint price;
    }

    mapping(uint => Song) public songs;

    function buySong(uint _id) public payable {
        Song memory song = songs[_id];
        require(msg.value >= song.price, "Not enough AVAX");

        payable(song.owner).transfer(msg.value);
        songs[_id].owner = msg.sender;
    }
}















string public musicCID;

function setMusicCID(string memory cid) public {
    musicCID = cid;
}